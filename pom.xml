<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.13</version>
    <relativePath/>
  </parent>

  <groupId>com.samp</groupId>
  <artifactId>attendance-portal</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>war</packaging>

  <name>Student Attendance Management Portal</name>
  <description>Attendance capture with a role-based approval workflow, delivered through a Jenkins CI/CD pipeline</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Deployable WAR name, kept stable so the Jenkins deploy stage and the
         Ansible/Tomcat target do not have to know the project version. -->
    <final.war.name>attendance-portal</final.war.name>
    <selenium.version>4.25.0</selenium.version>
  </properties>

  <dependencies>
    <!-- Web + server-rendered views (Thymeleaf keeps the UI directly drivable by Selenium) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <!-- Persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Role-based access control (US-01, US-02) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <!-- Bean validation for form input (AC-04.2, AC-06.4) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- /actuator/health drives the container and Ansible health checks (S13, AC-24.3) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Provided: the embedded container is excluded from the WAR so the same
         artefact also deploys into a standalone Tomcat 10.1 (constraint C2). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Selenium WebDriver: the UI quality gate (US-20, Tasks 9-10) -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${final.war.name}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Build info is exposed on /actuator/info so a running container can
               be traced back to the commit that produced it. -->
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Unit tests run on every build; the Selenium journeys live in the
           'selenium' profile so ordinary compile-time feedback stays fast while
           the gate still blocks deployment (Task 10). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/selenium/**</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn -Pselenium verify   runs the UI journeys.

      They are a separate profile, and bound to failsafe rather than surefire,
      because they need the application running: failsafe's pre/post-integration
      phases are what guarantee the context starts before and stops after, and a
      failure in them still runs the verify goal so the report is always produced.
    -->
    <profile>
      <id>selenium</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/selenium/*Test.java</include>
                <include>**/selenium/*IT.java</include>
              </includes>
              <systemPropertyVariables>
                <selenium.headless>${selenium.headless}</selenium.headless>
                <webdriver.chrome.driver>${webdriver.chrome.driver}</webdriver.chrome.driver>
                <selenium.chrome.binary>${selenium.chrome.binary}</selenium.chrome.binary>
                <selenium.screenshot.dir>${selenium.screenshot.dir}</selenium.screenshot.dir>
                <selenium.remote.url>${selenium.remote.url}</selenium.remote.url>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <selenium.headless>true</selenium.headless>
        <webdriver.chrome.driver>${project.basedir}/.tools/chromedriver</webdriver.chrome.driver>
        <selenium.chrome.binary>/opt/pw-browsers/chromium-1194/chrome-linux/chrome</selenium.chrome.binary>
        <selenium.screenshot.dir>${project.basedir}/docs/evidence/task-09/failures</selenium.screenshot.dir>
        <!-- Empty means drive a local browser; CI overrides it with the Grid URL. -->
        <selenium.remote.url></selenium.remote.url>
      </properties>
    </profile>
  </profiles>
</project>
